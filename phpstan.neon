includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 8
    paths:
        - app
    tmpDir: storage/phpstan

    # Level-8 findings are snapshotted in phpstan-baseline.neon (generated via
    # `vendor/bin/phpstan analyse --generate-baseline`). The gate is green today;
    # burn the baseline down incrementally as real bugs get fixed. New regressions
    # are always blocked.
