APP_NAME=WorkRide
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/dev-angle/Starter-folder/workride/public

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=workride
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@workride.ng"
MAIL_FROM_NAME="${APP_NAME}"

# Google OAuth (Google sign-in). Leave blank to hide the Google button.
# Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/auth/google/callback

# Paystack (wallet top-ups). Use test keys while developing.
# Console: https://dashboard.paystack.com/#/settings/developers
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_MODE=test

# Routing — open-source first (Sprint 5).
# Primary is self-hosted OSRM (free). Paid fallbacks are capped+logged.
# Start OSRM locally with: docker compose up -d osrm   (or a hosted OSRM URL)
OSRM_HOST=http://localhost:5000
OSRM_TIMEOUT=5
WORKRIDE_ROUTING_PRIMARY=osrm

# Paid fallbacks — keep OFF by default. Each call logs to api_cost_logs and is
# refused once WORKRIDE_MONTHLY_API_CAP_NAIRA is spent for the month.
USE_GOOGLE_FALLBACK=false
GOOGLE_MAPS_API_KEY=
GOOGLE_COST_PER_REQUEST=20
USE_MAPBOX_PREMIUM=false
MAPBOX_ACCESS_TOKEN=
MAPBOX_COST_PER_REQUEST=25
WORKRIDE_MONTHLY_API_CAP_NAIRA=20000

# Road sensor thresholds (Sprint 5) — World Bank RoadLab IRI formula.
WORKRIDE_POTHOLE_Z_THRESHOLD=15
WORKRIDE_IRI_ALPHA=2.0
WORKRIDE_IRI_BETA=1.5
WORKRIDE_ROAD_MAX_SPEED_KMH=200

# Time-Bank (Sprint 3.5) — "Ride Now, Drive Later" community reciprocity.
# Keep OFF until the pilot MDA is onboarded, then enable per-user group.
FEATURE_TIME_BANK=false
WORKRIDE_AVG_FARE_PER_SEAT=600
WORKRIDE_RIDE_CREDIT_DUE_DAYS=7
WORKRIDE_MAX_OWED_SEATS=3
WORKRIDE_UNION_FEE_RATE=0.05

# P2P wallet transfers between verified colleagues.
WORKRIDE_P2P_DAILY_LIMIT=10000
WORKRIDE_P2P_SENDER_LEVEL_THRESHOLD_AMOUNT=5000
WORKRIDE_P2P_FEE_CASH_RATE=0.01
WORKRIDE_P2P_FEE_CASH_MIN=10

# Driver earnings withdrawal (Moniepoint — mocked while unconfigured).
WORKRIDE_PAYOUT_MIN_AMOUNT=100
WORKRIDE_PAYOUT_MAX_AMOUNT=100000

# Promoted volunteer activities (Sprint 9 "Missions") — sponsors define
# activity + reward; the app observes real events and pays out automatically
# (auto) or after photo-proof review.
FEATURE_MISSIONS=false

# Tiered KYC (Sprint 3.6) — guide §7. Tier 1 (open staff-ID liveness) is free;
# Tiers 2/3 call licensed commercial providers, logged to api_cost_logs and
# capped per provider per month.
FEATURE_LIVENESS=false
WORKRIDE_VERIFY_ATTEMPTS_PER_DAY=5
WORKRIDE_LIVENESS_MIN_SCORE=75
WORKRIDE_SELFIE_RETENTION_DAYS=30
WORKRIDE_DRIVER_VERIFICATION_FEE=500

# Tier-0 phone verification (v0.11.0) — instant booking gate. Codes go to the
# database + app log until SMS is enabled.
FEATURE_PHONE_VERIFICATION=true
WORKRIDE_PHONE_OTP_TTL_MINUTES=10
WORKRIDE_PHONE_OTP_MAX_ATTEMPTS=5
WORKRIDE_PHONE_SEND_COOLDOWN_SECONDS=60
WORKRIDE_PHONE_SEND_DAILY_LIMIT=5

# Tier-0 OTP SMS delivery (pluggable; off by default — codes log instead).
WORKRIDE_SMS_ENABLED=false
WORKRIDE_SMS_PROVIDER=termii
TERMII_API_KEY=
TERMII_SENDER_ID=WorkRide
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Tier 2 — NIN via a NIMC-licensed partner (IdentityPass). The raw NIN is sent
# ONLY to this provider over TLS and never persisted; we store hash + last 4.
USE_IDENTITYPASS=false
IDENTITYPASS_API_KEY=
IDENTITYPASS_BASE_URL=https://api.myidentitypass.com
IDENTITYPASS_COST_NGN=100
IDENTITYPASS_MONTHLY_CAP_NGN=50000

# Tier 3 — driver anti-spoof liveness (Smile Identity SmartSelfie).
USE_SMILE=false
SMILE_PARTNER_ID=
SMILE_API_KEY=
SMILE_SID_SERVER=https://api.usesmileid.com
SMILE_WEBHOOK_SECRET=
SMILE_ANTI_SPOOF_THRESHOLD=80
SMILE_COST_NGN=400

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
